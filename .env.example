PORT=3001

# Postgres connection string (Render gives you this when you create a
# managed Postgres instance — "Internal Database URL" if the app and DB
# are both on Render, "External Database URL" otherwise)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string — used to sign session cookies
SESSION_SECRET=cfiiltlwth4oghhuhjbekbhoth;ohj;lj;bhtsbj;b

NODE_ENV=production

# Base URLs for the two tools (no trailing slash) — used to build the
# personalized QR code links
BRAVEEVE_BASE_URL=https://braveeve-app.onrender.com/
NCCN_BASE_URL=https://nccndistressthermometer-pbweerecxa9hzqe22xky3g.streamlit.app/

# Sarvam AI key for HCP interview voice transcription/translation
SARVAM_API_KEY=sk_or6kr5fw_PHMaO7dOeADOVRKcFdFGOXX5

# --- Completion notifications ---------------------------------------------
# The dashboard polls BraveEve's and NCCN's Google Sheets to detect when a
# patient finishes (or bails out of) either tool, then emails the team so
# someone can follow up with the QQ-10 interview. Leave both sheet IDs
# blank to disable polling entirely.
#
# Needs a Google service account with *read* access to both sheets (share
# each sheet with the service account's email, Viewer is enough) — you can
# reuse the same service account BraveEve/NCCN already use for writing, or
# create a separate read-only one.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

BRAVEEVE_GOOGLE_SHEET_ID=
BRAVEEVE_GOOGLE_SHEET_TAB=responses
NCCN_GOOGLE_SHEET_ID=
NCCN_GOOGLE_SHEET_TAB=responses

# How often to poll, in milliseconds (default: 2 minutes)
COMPLETION_POLL_INTERVAL_MS=120000

# SMTP for the email alert (e.g. an SMTP relay, or Gmail with an App
# Password). Leave blank to log what would have been sent instead of
# actually emailing -- useful for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
# Comma-separated list -- everyone on the study team who should get the alert
NOTIFY_EMAIL_TO=

# Used in the email body as a link back to the dashboard (no trailing slash)
DASHBOARD_BASE_URL=
